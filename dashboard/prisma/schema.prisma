// Prisma schema for dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SpreadSample {
  id         Int      @id @default(autoincrement())
  symbol     String
  openSpread Decimal
  closeSpread Decimal
  midline    Decimal
  upper      Decimal
  lower      Decimal
  openMakerThreshold Decimal @default(0)
  openTakerThreshold Decimal @default(0)
  openMakerExitThreshold Decimal @default(0)
  closeMarketThreshold Decimal @default(0)
  closeLimitThreshold Decimal @default(0)
  closeLimitExitThreshold Decimal @default(0)
  extBid     Decimal
  extAsk     Decimal
  ligBid     Decimal
  ligAsk     Decimal
  createdAt  DateTime @default(now())

  @@index([symbol, createdAt])
}

model PositionSnapshot {
  id             Int      @id @default(autoincrement())
  symbol         String
  extQty         Decimal
  ligQty         Decimal
  extAvailUsd    Decimal
  ligAvailUsd    Decimal
  extTotalUsd    Decimal @default(0)
  ligTotalUsd    Decimal @default(0)
  extVolume      Decimal @default(0)
  ligVolume      Decimal @default(0)
  totalVolume    Decimal @default(0)
  extOpenTakerVolume Decimal @default(0)
  extOpenMakerVolume Decimal @default(0)
  ligOpenTakerVolume Decimal @default(0)
  ligOpenMakerVolume Decimal @default(0)
  createdAt      DateTime @default(now())

  @@index([symbol, createdAt])
}

model BotEvent {
  id        Int      @id @default(autoincrement())
  symbol    String
  level     String
  eventType String
  message   String
  state     String?
  createdAt DateTime @default(now())

  @@index([symbol, createdAt])
}

model PnlSnapshot {
  id          Int      @id @default(autoincrement())
  symbol      String
  profit      Decimal
  entrySpread Decimal @default(0)
  closeSpread Decimal @default(0)
  idealRate   Decimal @default(0)
  actualRate  Decimal @default(0)
  fundsDelta  Decimal @default(0)
  fundsCum    Decimal @default(0)
  cumulative  Decimal
  createdAt   DateTime @default(now())

  @@index([symbol, createdAt])
}

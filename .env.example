# Spread Arbitrage Bot Configuration Example
# Copy this file to .env and adjust values as needed

# =============================================================================
# Basic Configuration
# =============================================================================

# Trading ticker symbol (default: ETH)
TICKER=ETH

# Order quantity in USDT per trade (default: 35)
ORDER_QUANTITY_USDT=35

# =============================================================================
# Spread Threshold Configuration (优化后的阈值设置)
# =============================================================================

# Minimum spread rate to open position (default: 0.0005 = 0.05%)
# 降低后的阈值: 从 0.08% (0.0008) 降至 0.05% (0.0005)
# 能够覆盖 Extended taker 手续费 (双边: 0.0225% * 2 = 0.045%)
MIN_SPREAD_RATE=0.0005

# Latency buffer for execution delays (default: 0.0001 = 0.01%)
# 执行延迟缓冲,考虑到价格滑点和网络延迟
LATENCY_BUFFER=0.0001

# =============================================================================
# Closing Strategy Configuration (智能平仓策略)
# =============================================================================

# Enable profit target closing (default: True)
# 盈利目标平仓开关
ENABLE_PROFIT_TARGET=True

# Profit target rate for immediate closing (default: 0.0005 = 0.05%)
# 达到此盈利率立即平仓 (最高优先级)
PROFIT_TARGET_RATE=0.0005

# Enable time-based small profit closing (default: True)
# 时间小额平仓开关
ENABLE_TIME_CLOSE=True

# Time threshold for small profit closing in seconds (default: 60)
# 持仓超过此时间后,即使小额利润也会平仓
TIME_CLOSE_THRESHOLD=60

# Maximum holding time in seconds (default: 300 = 5 minutes)
# 超过此时间强制平仓,无论盈亏
MAX_HOLDING_TIME=300

# Profit threshold for time-based closing (default: 0.0001 = 0.01%)
# 时间小额平仓的最小利润要求
TIME_CLOSE_PROFIT_THRESHOLD=0.0001

# =============================================================================
# Stop Loss Configuration
# =============================================================================

# Enable traditional stop loss (default: True)
# 传统止损开关
ENABLE_STOP_LOSS=True

# Stop loss amount in USDT (default: 5)
# 亏损达到此金额时触发止损
STOP_LOSS_USDT=5

# Allow closing with negative PnL (default: False)
# 是否允许亏损平仓 (仅在特定条件下)
ALLOW_NEGATIVE_CLOSE=False

# =============================================================================
# Position Management
# =============================================================================

# Maximum number of open spread pairs (default: 3)
# 最大同时持仓套利对数量
MAX_OPEN_PAIRS=3

# Maximum total position in USDT (default: 25)
# 最大总持仓金额 (USDT)
MAX_TOTAL_POSITION_USDT=25

# =============================================================================
# Lighter Depth & Slippage Settings
# =============================================================================

# Maximum ratio of Lighter depth to use (default: 0.5 = 50%)
# 最多使用 Lighter 订单簿深度的 50%,避免过度冲击
MAX_LIGHTER_DEPTH_RATIO=0.5

# Minimum required Lighter depth in USDT (default: 200)
# Lighter 最小深度要求 (USDT),低于此值不交易
MIN_LIGHTER_DEPTH_USDT=200

# Number of orderbook depth layers to check (default: 3)
# 检查订单簿的档位数
CHECK_DEPTH_LAYERS=3

# Slippage tolerance (default: 0.001 = 0.1%)
# 滑点容忍度
SLIPPAGE_TOLERANCE=0.001

# =============================================================================
# Unhedged Position Protection (单边持仓保护)
# =============================================================================

# Maximum allowed unhedged positions (default: 0)
# 最大允许单边持仓数量 (0 表示禁止单边持仓)
MAX_UNHEDGED_POSITIONS=0

# Auto-close unhedged positions (default: False)
# 是否自动平仓单边持仓
AUTO_CLOSE_UNHEDGED=False

# Timeout for unhedged position alarm in seconds (default: 60)
# 单边持仓超时告警时间 (从 300 秒降至 60 秒)
UNHEDGED_TIMEOUT=60

# =============================================================================
# Hedge Failure Detection
# =============================================================================

# Hedge failure threshold rate (default: 0.3 = 30%)
# 对冲失败率阈值,超过此值暂停交易
HEDGE_FAILURE_THRESHOLD=0.3

# Window for hedge failure calculation in seconds (default: 10)
# 对冲失败率计算窗口 (秒)
HEDGE_FAILURE_WINDOW=10

# =============================================================================
# Reconciliation Settings
# =============================================================================

# Enable position reconciliation (default: True)
# 是否启用仓位对账
ENABLE_RECONCILIATION=True

# Reconciliation interval in seconds (default: 60)
# 仓位对账间隔 (秒)
RECONCILIATION_INTERVAL=60

# =============================================================================
# Timeout Settings
# =============================================================================

# Extended order fill timeout in seconds (default: 10)
# Extended 订单超时时间
EXTENDED_FILL_TIMEOUT=10

# Lighter hedge timeout in seconds (default: 3)
# Lighter 对冲超时时间
LIGHTER_HEDGE_TIMEOUT=3

# =============================================================================
# Trading Control
# =============================================================================

# Maximum consecutive failures before pause (default: 3)
# 最大连续失败次数
MAX_CONSECUTIVE_FAILURES=3

# Cooldown period between failures in seconds (default: 60)
# 失败后的冷却时间 (秒)
COOLDOWN_PERIOD=60

# Prioritize closing over opening (default: True)
# 优先平仓而非开新仓
PRIORITIZE_CLOSING=True

# Enable partial fill handling (default: True)
# 是否启用部分成交处理
ENABLE_PARTIAL_FILL=True

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# 日志级别
LOG_LEVEL=INFO
